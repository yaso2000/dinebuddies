{
  "appId": "com.dinebuddies.app",
  "appName": "DineBuddies",
  "webDir": "dist",
  "server": {
    "hostname": "www.dinebuddies.com",
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com", "facebook.com", "apple.com"]
    },
    "Keyboard": {
      "resize": "native",
      "resizeOnFullScreen": true
    }
  }
}
